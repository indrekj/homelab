# Copy to .env and fill in. Never commit .env.

# Traefik ACME (Cloudflare DNS-01)
LETSENCRYPT_EMAIL=you@example.com
CLOUDFLARE_API_TOKEN=

# PostgreSQL superuser password.
POSTGRES_PASSWORD=""

# Plex claim token from https://www.plex.tv/claim — only needed on first
# run of a fresh install; leave blank once Plex has been claimed.
PLEX_CLAIM=

# Recyclarr syncs TRaSH-Guides settings into Radarr/Sonarr. API keys from each
# app's Settings -> General -> Security.
RADARR_API_KEY=
SONARR_API_KEY=

# AirVPN WireGuard for qBittorrent, from the Config Generator in the client
# area. WIREGUARD_ADDRESSES takes the IPv4 address only, such as 10.1.2.3/32.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=
# Port reserved under Client Area -> Ports, for TCP and UDP. Leave its local
# port empty there.
AIRVPN_PORT=
